# ============================================================
# SLBS Academy CRM — Server Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# Server
PORT=5000
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────
# Production (Render + Supabase): set DATABASE_URL only.
# Get it from: Supabase Dashboard → Project Settings → Database → URI
# DATABASE_URL=postgresql://postgres.xxxx:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.co:6543/postgres

# Local development (SQLite — leave DATABASE_URL unset):
# No config needed; SQLite file is created automatically.

# Local development (PostgreSQL):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=crm_db
DB_USER=crm_user
DB_PASSWORD=your_local_postgres_password
DB_SSL=false

# ── Auth ──────────────────────────────────────────────────────
# Use a strong random secret in production (min 64 chars).
# Render can auto-generate this with generateValue: true.
JWT_SECRET=your_very_long_random_secret_key_minimum_64_characters_long_change_this_in_production

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# In production, set this to your Vercel URL.
CORS_ORIGIN=http://localhost:3001,http://localhost:5173

# ── Default Admin Seed ───────────────────────────────────────
# Admin user created on first boot if it doesn't exist.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=salesadmin@1234
